          }
        }
      }
    },
    {
      "id": "703a3b8e-2900-4abd-8b89-875813335699",
      "name": "Start one run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        660,
        120
      ],
      "parameters": {
        "url": "={{ 'https://api.apify.com/v2/acts/' + encodeURIComponent($json.actorId) + '/runs' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "method": "POST",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "memory",
              "value": "512"
            },
            {
              "name": "timeout",
              "value": "180"
            },
            {
              "name": "restartOnError",
              "value": "false"
            },
            {
              "name": "maxTotalChargeUsd",
              "value": "={{ $json.maxTotalChargeUsd }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.input) }}"
      }
    },
    {
      "id": "b08de9e9-3a72-4183-b93a-551acd023cc0",
      "name": "Inspect run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "jsCode": "const run = $input.first().json.data;\nif (!run?.id || !run.status) throw new Error('Apify did not return a run ID and status. Check Console before starting another run.');\nconst terminal = ['SUCCEEDED','FAILED','TIMED-OUT','ABORTED'].includes(run.status);\nif (!terminal && $runIndex >= 60) throw new Error('Polling stopped. Resume run '+run.id+'; do not start a replacement.');\nreturn [{json:{run,terminal}}];"
      }
    },
    {
      "id": "b7c5142e-cddb-413b-bde2-5fdfa40041a6",
      "name": "Run finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "2a6f2bba-39b2-4918-8e14-7560b8ffb910",
              "leftValue": "={{ $json.terminal }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
