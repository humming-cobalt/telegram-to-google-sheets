    {
      "id": "2a221a6d-3a34-4c6b-861a-3e2c7a2117e2",
      "name": "Keep run and report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        0
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst run = $('Inspect run').item.json.run;\nif (response.statusCode !== 200 && response.statusCode !== 404) throw new Error('Could not read report for '+run.id+'. Resume this run after fixing API access.');\nconst report = response.statusCode === 200 ? response.body : null;\nreturn [{json:{run,report}}];"
      }
    },
    {
      "id": "a0b570de-984a-453b-8e8b-78f41edb5e39",
      "name": "Get saved posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1780,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.apify.com/v2/datasets/' + encodeURIComponent($json.run.defaultDatasetId) + '/items?format=json&clean=true&limit=10000' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      }
    },
    {
      "id": "9efe43e1-6adb-4326-a5e9-db5ef9cbd50d",
      "name": "Prepare rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        0
      ],
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst context = $('Keep run and report').item.json;\nif (response.statusCode !== 200 || !Array.isArray(response.body)) throw new Error('Dataset could not be read. Resume this same run ID.');\nconst total = Number(response.headers?.['x-apify-pagination-total']);\nif (Number.isFinite(total) && total > response.body.length) throw new Error('Dataset has more rows than this demo fetched. Export the full dataset before proceeding.');\n// Sheets uses RAW: preserve text literally, including formula-like prefixes.\nconst safe = value => String(value ?? '');\nconst unique = new Map();\nfor (const p of response.body) {\n if (!p.id || !p.channel || !p.publishedAt || !p.url) throw new Error('Unexpected post row. Inspect the original dataset.');\n unique.set(p.id,{id:p.id,channel:safe(p.channel),publishedAt:p.publishedAt,text:safe(p.text),url:p.url,views:p.views ?? '',runId:context.run.id});\n}\nconst posts=[...unique.values()];\nconst healthy=context.run.status==='SUCCEEDED' && ['COMPLETE','EMPTY'].includes(context.report?.outcome);\nreturn [{json:{...context,posts,needsAttention:!healthy}}];"
      }
    },
    {
      "id": "64c90db4-d9d8-4326-9d77-aaab608cd18a",
      "name": "Has posts?",
      "type": "n8n-nodes-base.if",
