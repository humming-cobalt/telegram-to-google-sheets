    {
      "id": "1f4bab7f-5dd1-40be-9255-d2df8c4711c5",
      "name": "Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Use a unique monitorId for your feed. Keep it unchanged between collections.\n// To retry a Sheets import, set resumeRunId to the ORIGINAL Apify run ID.\n// Credentials belong in n8n Credentials, never in this code.\nconst config = {\n actorId:'rm4iUmn6dCIoClTps',\n resumeRunId:'',\n maxTotalChargeUsd:0.05,\n input:{channels:['bbcrussian'],monitorId:'telegram-sheets-demo',firstRunMode:'recent',initialLookbackHours:24,keywords:[],maxPostsPerChannel:20,maxPagesPerChannel:10,requestDelayMs:600,maxChargeUsd:0.05}\n};\nconfig.resumeRunId = config.resumeRunId.trim();\nif (config.resumeRunId && !/^[A-Za-z0-9]+$/.test(config.resumeRunId)) throw new Error('Paste only the Apify run ID, not a URL.');\nif (!Number.isFinite(config.maxTotalChargeUsd) || config.maxTotalChargeUsd < 0.01 || config.maxTotalChargeUsd > 1) throw new Error('Demo platform budget must be between $0.01 and $1.');\nreturn [{json:config}];"
      }
    },
    {
      "id": "5ac82ff9-936d-4b85-a8da-7831df8e1eee",
      "name": "Resume existing run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "dcc6c25b-34fa-4170-abae-87d47545dc3a",
              "leftValue": "={{ $json.resumeRunId.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4f3a8e7c-0672-4ab7-9892-d0824606b004",
      "name": "Load existing run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        660,
        -160
      ],
      "parameters": {
        "url": "={{ 'https://api.apify.com/v2/actor-runs/' + encodeURIComponent($json.resumeRunId) }}",
        "authentication": "genericCredentialType",
