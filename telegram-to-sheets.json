      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        -120
      ],
      "parameters": {
        "jsCode": "return $input.first().json.posts.map(p => ({json:p,pairedItem:{item:0}}));"
      }
    },
