            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "742e8f74-5812-468b-8683-3c47ceeb75fc",
              "leftValue": "={{ $json.posts.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a72564e8-d9a8-4616-9032-b696b9ffec6c",
