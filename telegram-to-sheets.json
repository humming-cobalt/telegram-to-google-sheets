    {
      "id": "d6a9f2fe-4c42-43b6-a6f3-9f9f164a0208",
      "name": "Get report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1340,
        0
      ],
      "parameters": {
        "url": "={{ 'https://api.apify.com/v2/key-value-stores/' + encodeURIComponent($json.run.defaultKeyValueStoreId) + '/records/REPORT' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
